{
  "name": "aungsha-mobile-app-test",
  "version": "1.0.0",
  "description": "Aungsha Android login automation with Appium, WebdriverIO, POM and OOP",
  "private": true,
  "scripts": {
    "appium": "appium --address 127.0.0.1 --port 4723 --relaxed-security --allow-cors",
    "test": "wdio run wdio.conf.js",
    "test:login": "wdio run wdio.conf.js --spec ./src/tests/login-flow.test.js",
    "test:buy": "wdio run wdio.conf.js --spec ./src/tests/buy-flow.test.js",
    "test:buy:script": "node ./scripts/project-buy-flow.js",
    "test:buy:wdio": "wdio run wdio.conf.js --spec ./src/tests/buy-flow.test.js",
    "inspect:device": "node ./scripts/inspect-device.js"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "pom",
    "android",
    "aungsha"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@wdio/appium-service": "^9.16.2",
    "@wdio/cli": "^9.16.2",
    "@wdio/local-runner": "^9.16.2",
    "@wdio/mocha-framework": "^9.16.2",
    "@wdio/spec-reporter": "^9.16.2",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.3",
    "dotenv": "^16.5.0",
    "expect-webdriverio": "^6.0.9",
    "webdriverio": "^9.16.2"
  }
}
